POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_local_change_me
POSTGRES_PORT=15432
# Local development only. Compose supplies its own PostgreSQL URL.
DATABASE_URL=sqlite:///./radar.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary public-profile provider (server only; never VITE_*).
BRIGHT_DATA_API_KEY=
# SERP API zone for creator discovery (same API key).
BRIGHT_DATA_SERP_ZONE=serp_api1
# Verify these scraper IDs in your Bright Data account before enabling.
BRIGHT_DATA_INSTAGRAM_DATASET_ID=gd_l1vikfch901nx3by4
BRIGHT_DATA_YOUTUBE_DATASET_ID=gd_lk538t2k2p1k3oos71
# Reels discover-by-URL, for accounts related to the brand (collaborations and tags).
BRIGHT_DATA_INSTAGRAM_REELS_DATASET_ID=gd_lyclm20il4r5helnj
BRIGHT_DATA_MAX_NEW_JOBS_PER_ANALYSIS=4
BRIGHT_DATA_JOB_TIMEOUT_SECONDS=600

# Official API fallbacks; optional when Bright Data works.
YOUTUBE_API_KEY=
# True only after satisfying the provider's applicable analytics requirements.
YOUTUBE_ANALYTICS_APPROVED=false
META_ACCESS_TOKEN=
META_IG_USER_ID=
# Set a supported Graph API version from your Meta application (e.g. vNN.N).
META_GRAPH_VERSION=
