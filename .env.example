POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_local_change_me
POSTGRES_PORT=15432
# Local development only. Compose supplies its own PostgreSQL URL.
DATABASE_URL=sqlite:///./radar.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary public-profile provider (server only; never VITE_*).
BRIGHT_DATA_API_KEY=
# SERP API zone for creator discovery (same API key).
BRIGHT_DATA_SERP_ZONE=serp_api1
# Verify these scraper IDs in your Bright Data account before enabling.
BRIGHT_DATA_INSTAGRAM_DATASET_ID=gd_l1vikfch901nx3by4
BRIGHT_DATA_YOUTUBE_DATASET_ID=gd_lk538t2k2p1k3oos71
# Reels discover-by-URL, for accounts related to the brand (collaborations and tags).
BRIGHT_DATA_INSTAGRAM_REELS_DATASET_ID=gd_lyclm20il4r5helnj
# Posts discover-by-URL: last 30 days, max 30 posts per creator, for the post relevance baseline.
BRIGHT_DATA_INSTAGRAM_POSTS_DATASET_ID=gd_lk5ns7kz21pck8jpis
# Max creators per run whose posts are requested (each costs up to 30 records).
BRIGHT_DATA_MAX_POST_CREATORS=15
# Posts collected more recently than this are reused instead of paid again.
INSTAGRAM_POSTS_TTL_HOURS=24
# Creators below this follower count are left out of the posts baseline.
INSTAGRAM_MIN_FOLLOWERS=2000

# TikTok creator discovery (same API key). Empty dataset IDs use the published scrapers:
# posts gd_lu702nij2f790tmv9h (discover by keyword and by profile URL), profiles gd_l1villgoiiidt09ci.
BRIGHT_DATA_TIKTOK_POSTS_DATASET_ID=
BRIGHT_DATA_TIKTOK_PROFILES_DATASET_ID=
# Videos requested per keyword in the topic search (each one is a billed record).
TIKTOK_VIDEOS_PER_KEYWORD=20
# Authors that move on to the (billed) profile stage, after discarding brand, small and stale accounts.
TIKTOK_MAX_CANDIDATES=20
# Keyword search runs much longer than a profile collection; it gets its own limit.
TIKTOK_SEARCH_TIMEOUT_SECONDS=2700
TIKTOK_POSTS_TIMEOUT_SECONDS=2700
# An author found only with videos older than this is not a current reference.
TIKTOK_MAX_VIDEO_AGE_DAYS=180
TIKTOK_MIN_FOLLOWERS=5000
TIKTOK_PROFILE_TTL_DAYS=30
TIKTOK_POSTS_TTL_HOURS=24
BRIGHT_DATA_MAX_NEW_JOBS_PER_ANALYSIS=4
BRIGHT_DATA_JOB_TIMEOUT_SECONDS=600

# Official API fallbacks; optional when Bright Data works.
YOUTUBE_API_KEY=
# True only after satisfying the provider's applicable analytics requirements.
YOUTUBE_ANALYTICS_APPROVED=false
META_ACCESS_TOKEN=
META_IG_USER_ID=
# Set a supported Graph API version from your Meta application (e.g. vNN.N).
META_GRAPH_VERSION=

# LLM review of discovered accounts (server only; never VITE_*).
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-6-luna
OPENAI_REVIEW_EFFORT=low

# Radar de tendencias LinkedIn + YouTube (server only; never VITE_*).
# YouTube Data API v3 (demanda) reutiliza YOUTUBE_API_KEY de arriba.
# Exa: índice de búsqueda para descubrir posts públicos de LinkedIn.
EXA_API_KEY=
# Opcional: segundo índice de LinkedIn para más cobertura.
BRAVE_API_KEY=
# Claude: clasificación, tópicos y propuestas.
ANTHROPIC_API_KEY=
# haiku = todas las llamadas en Haiku 5.5 (pruebas baratas). Vacío = modelos normales.
RADAR_LLM=
# sonnet (por defecto) u opus para la taxonomía de tópicos y las propuestas.
RADAR_TOP_MODEL=sonnet
RUN_BUDGET_USD=6
# Cada cuántas horas se vuelven a leer las vistas de YouTube; 0 lo desactiva.
TRENDS_SNAPSHOT_HOURS=6
# Desarrollo local sin Docker; Compose usa un volumen propio.
TRENDS_DB_PATH=./trends.db
# Reel transcription (same API key): first seconds of audio only.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TRANSCRIPT_MAX_SECONDS=30

# Production analysis of reels with Gemini (first 30 s of video). Only the best on-topic reels.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CONTENT_TOP_REELS=5
# Seconds of video sent per reel: every second costs tokens.
CONTENT_CLIP_SECONDS=10
# Normal reels of the same creators to contrast against; 0 = only report what the top reels share.
CONTENT_CONTROL_REELS=0
